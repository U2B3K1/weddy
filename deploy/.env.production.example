# ===== Libosa — production .env namunasi =====
# Bu faylni serverda /var/www/libosa/backend/.env ga ko'chiring va qiymatlarni to'ldiring.
# HECH QACHON gitga commit qilmang (.gitignore himoyalaydi).

# Django maxfiy kaliti — tasodifiy, uzun (50+ belgi) qiymat bering:
SECRET_KEY=o-zgartiring-tasodifiy-uzun-maxfiy-kalit

# Productionda False bo'lishi SHART:
DEBUG=False

# Domenlar (www kerak bo'lmasa olib tashlang):
ALLOWED_HOSTS=libosa.uz,www.libosa.uz

# PostgreSQL (serverdagi mahalliy baza):
DATABASE_URL=postgres://libosa:KUCHLI_PAROL@127.0.0.1:5432/libosa

# Frontend qaysi manzildan keladi (same-origin bo'lsa ham yozing):
CORS_ALLOWED_ORIGINS=https://libosa.uz,https://www.libosa.uz

# Telegram bot (bo'sh bo'lsa xabarlar faqat navbatda turadi):
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Eskiz SMS (bo'sh bo'lsa SMS yuborilmaydi, jurnalga yoziladi):
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
